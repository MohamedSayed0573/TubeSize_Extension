{
    "name": "tubesize",
    "private": true,
    "version": "3.0.2",
    "type": "module",
    "packageManager": "bun@1.4.3",
    "trustedDependencies": [
        "@parcel/watcher",
        "unrs-resolver"
    ],
    "scripts": {
        "all": "concurrently \"bun run build\" \"bun run lint\" \"bun run test\"",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "analyze": "rm -rf ./stats && ANALYZE=true wxt build && bunx serve ./stats",
        "postinstall": "wxt prepare",
        "test": "bun test --isolate",
        "test:coverage": "bun test --coverage --isolate",
        "prettier:write": "bunx prettier . --write",
        "prettier:check": "bunx prettier . --check",
        "lint": "oxlint .",
        "tsc": "tsc --noEmit",
        "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
        "prepare": "husky",
        "lint-staged": "lint-staged"
    },
    "lint-staged": {
        "*.{css,html,js,jsx,json,md,ts,tsx}": "prettier --write"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.104.3",
        "cheerio": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dexie": "^4.4.6",
        "dexie-react-hooks": "^4.4.0",
        "filesize": "^11.0.26",
        "lucide-react": "^1.57.0",
        "m3u8-parser": "^7.2.0",
        "pretty-ms": "^10.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.4.0",
        "recharts": "^3.10.1",
        "shadcn": "^4.21.5",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tldts-icann": "^7.4.18",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bun": "^1.4.3",
        "@types/chrome": "^0.3.5",
        "@types/m3u8-parser": "^7.2.6",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@wxt-dev/module-react": "^1.2.2",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "husky": "^9.1.7",
        "knip": "^6.41.0",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.4",
        "wxt": "^0.21.4"
    }
}

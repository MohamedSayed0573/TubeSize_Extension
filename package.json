{
    "name": "tubesize",
    "private": true,
    "version": "2.3.4",
    "type": "module",
    "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
    "scripts": {
        "all": "concurrently \"pnpm run build\" \"pnpm run lint\" \"pnpm run test\"",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "analyze": "ANALYZE=true wxt build && npx serve ./stats",
        "postinstall": "wxt prepare",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:preview": "wslview ./coverage/lcov-report/index.html",
        "prettier:write": "pnpm exec prettier . --write",
        "prettier:check": "pnpm exec prettier . --check",
        "pack": "pnpm run zip",
        "pack:firefox": "pnpm run zip:firefox",
        "lint": "eslint .",
        "tsc": "tsc --noEmit",
        "release": "node ./scripts/release.cjs",
        "knip": "knip",
        "prepare": "husky",
        "lint-staged": "lint-staged"
    },
    "lint-staged": {
        "*.{css,html,js,jsx,json,md,ts,tsx}": "prettier --write"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.103.2",
        "cheerio": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.4.0",
        "dexie": "^4.4.6",
        "dexie-react-hooks": "^4.4.0",
        "filesize": "^11.0.24",
        "i18next": "^26.4.2",
        "lucide-react": "^1.47.0",
        "m3u8-parser": "^7.2.0",
        "pretty-ms": "^9.3.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.15",
        "react-router": "^8.4.0",
        "recharts": "^3.10.1",
        "shadcn": "^4.21.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tldts": "^7.4.14",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tanstack/eslint-plugin-query": "^5.103.2",
        "@types/chrome": "^0.3.0",
        "@types/jest": "^30.0.0",
        "@types/m3u8-parser": "^7.2.6",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@wxt-dev/module-react": "^1.2.2",
        "concurrently": "^10.0.5",
        "eslint": "^10.11.0",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-unicorn": "^76.0.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-extended": "^7.0.0",
        "knip": "^6.37.0",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "ts-jest": "^29.4.12",
        "typescript": "6.0.3",

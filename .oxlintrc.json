{
    "plugins": ["typescript", "react", "jsx-a11y", "unicorn", "promise", "oxc"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "options": {
        "typeAware": true
    },
    "env": {
        "builtin": true,
        "browser": true,
        "es2026": true
    },
    "globals": {
        "AsyncDisposableStack": "readonly",
        "DisposableStack": "readonly",
        "SuppressedError": "readonly"
    },
    "ignorePatterns": [
        "dist",
        "dist_firefox",
        ".output",
        ".wxt",
        "coverage",
        "src/components/ui",
        "devTest"
    ],
    "rules": {
        "typescript/consistent-return": "off",
        "typescript/no-unsafe-type-assertion": "error",
        "no-console": [
            "warn",
            {
                "allow": ["error"]
            }
        ],
        "no-empty": "error",
        "no-unused-vars": "off",
        "typescript/no-empty-object-type": "off",
        "typescript/no-explicit-any": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "react/react-in-jsx-scope": "off",
        "react/only-export-components": [
            "error",
            {
                "allowConstantExport": true,
                "allowCompoundComponents": true
            }
        ],
        "unicorn/catch-error-name": [
            "error",
            {
                "name": "err"
            }
        ],
        "unicorn/filename-case": [
            "error",
            {
                "case": "camelCase"
            }
        ],
        "unicorn/no-array-sort": "off"
    },
    "overrides": [
        {
            "files": ["src/**/*.{ts,tsx}"],
            "rules": {
                "no-restricted-globals": [
                    "error",
                    {
                        "name": "process",
                        "message": "Node globals are not available in browser extension code."
                    },
                    {
                        "name": "Buffer",
                        "message": "Node globals are not available in browser extension code."
                    },
                    {
                        "name": "__dirname",
                        "message": "Node globals are not available in browser extension code."
                    },
                    {
                        "name": "__filename",
                        "message": "Node globals are not available in browser extension code."
                    },
                    {
                        "name": "global",
                        "message": "Use globalThis in browser extension code."
                    }
                ],
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["node:*", "bun", "bun:*"],
                                "message": "Node and Bun built-in modules cannot be imported in browser extension code."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["src/tests/**/*.{ts,tsx}"],
            "env": {
                "jest": true,
                "node": true
            },
            "rules": {
                "typescript/no-unsafe-type-assertion": "off",
                "no-restricted-globals": "off",
                "no-restricted-imports": "off"
            }
        },
        {
            "files": ["scripts/**/*.{ts,tsx}", "wxt.config.ts"],
            "env": {
                "node": true
            },
            "rules": {
                "typescript/no-unsafe-type-assertion": "off"
            }
        }
    ]
}

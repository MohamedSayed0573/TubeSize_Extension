{
    "name": "tubesize",
    "private": true,
    "version": "2.3.4",
    "type": "module",
    "packageManager": "pnpm@11.9.0",
    "scripts": {
        "all": "concurrently \"pnpm run build\" \"pnpm run lint\" \"pnpm run test\"",
        "build": "tsc -b && vite build",
        "dev": "vite",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:preview": "wslview ./coverage/lcov-report/index.html",
        "prettier:write": "pnpm exec prettier . --write",
        "prettier:check": "pnpm exec prettier . --check",
        "pack": "rm -rf dist && pnpm run build && zip -r dist/tubesize.zip dist",
        "pack:firefox": "rm -rf dist_firefox && pnpm run build && sh ./scripts/pack-firefox.sh",
        "lint": "eslint .",
        "preview": "vite preview",
        "tsc": "tsc --noEmit",
        "release": "node ./scripts/release.cjs",
        "knip": "knip",
        "prepare": "husky",
        "lint-staged": "lint-staged"
    },
    "lint-staged": {
        "*.{css,html,js,jsx,json,md,ts,tsx}": "prettier --write"
    },
    "knip": {
        "entry": [
            "src/background.ts",
            "src/content.ts",
            "src/observer.ts",
            "scripts/generate-firefox-manifest.cjs",
            "src/genericObserver.ts"
        ],
        "ignoreBinaries": [
            "wslview"
        ],
        "vite": true,
        "jest": true
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.101.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "filesize": "^11.0.22",
        "humanize-duration": "^3.34.1",
        "m3u8-parser": "^7.2.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^6.1.3",
        "react-router": "^8.3.0",
        "recharts": "^3.10.1",
        "shadcn": "^4.19.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@eslint/js": "^10.0.1",
        "@tanstack/eslint-plugin-query": "^5.101.4",
        "@types/chrome": "^0.2.6",
        "@types/humanize-duration": "^3.27.4",
        "@types/jest": "^30.0.0",
        "@types/m3u8-parser": "^7.2.6",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.8.1",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "eslint-plugin-unicorn": "^73.0.0",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-extended": "^7.0.0",
        "knip": "^6.32.2",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "ts-jest": "^29.4.12",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vite-plugin-zip-pack": "^1.2.4"
    }
}

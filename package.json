{
    "name": "tubesize",
    "version": "3.0.4",
    "private": true,
    "type": "module",
    "scripts": {
        "all": "bun run tsc && bun run lint --max-warnings=0 && bun run prettier:check && bun run knip && bun run test && bun run build && bun run build:firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "analyze": "rm -rf ./stats && ANALYZE=true wxt build && bunx serve ./stats",
        "postinstall": "bun scripts/checkBun.ts && wxt prepare",
        "test": "bun test --isolate",
        "test:coverage": "bun test --coverage --isolate",
        "prettier:write": "bun fmt . --write",
        "prettier:check": "bun fmt --check",
        "prelint": "bun scripts/checkBun.ts",
        "lint": "bun lint .",
        "tsc": "bun check -p tsconfig.app.json && bun check -p tsconfig.mainWorld.json && bun check -p tsconfig.scripts.json",
        "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
        "verify": "bun scripts/verify.ts",
        "prepare": "husky"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-query": "^5.108.1",
        "@webext-core/messaging": "^4.0.1",
        "@wxt-dev/storage": "^1.3.0",
        "cheerio": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dexie": "^4.4.7",
        "dexie-react-hooks": "^4.4.0",
        "filesize": "^11.0.35",
        "lucide-react": "^1.76.0",
        "m3u8-parser": "^7.2.1",
        "pretty-ms": "^10.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.2",
        "recharts": "^3.11.0",
        "shadcn": "^4.23.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5",
        "tldts-icann": "^7.5.5",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/chrome": "^0.3.7",
        "@types/m3u8-parser": "^7.2.6",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@webext-core/fake-browser": "^2.0.1",
        "@wxt-dev/module-react": "^1.2.2",
        "fake-indexeddb": "^6.2.8",
        "happy-dom": "^21.0.4",
        "husky": "^9.1.7",
        "knip": "^6.46.1",
        "playwright-core": "^1.65.1",
        "rollup-plugin-visualizer": "^7.1.3",
        "vite": "^8.3.8",
        "wxt": "^0.21.5"
    },
    "packageManager": "bun@1.4.6-canary.1",
    "trustedDependencies": [
        "@parcel/watcher",
        "unrs-resolver"
    ]
}

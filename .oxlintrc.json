{
    "plugins": ["typescript", "react", "jsx-a11y", "unicorn", "promise", "oxc", "import"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "options": {
        "typeAware": true
    },
    "env": {
        "builtin": true,
        "browser": true,
        "es2026": true
    },
    "globals": {
        "AsyncDisposableStack": "readonly",
        "DisposableStack": "readonly",
        "SuppressedError": "readonly"
    },
    "ignorePatterns": [
        "dist",
        "dist_firefox",
        ".output",
        ".wxt",
        "coverage",
        "src/components/ui",
        "devTest",
        "website"
    ],
    "rules": {
        "typescript/consistent-return": "off",
        "typescript/no-unsafe-type-assertion": "error",
        "no-console": [
            "warn",
            {
                "allow": ["error"]
            }
        ],
        "no-empty": "error",
        "no-unused-vars": "off",
        "typescript/no-empty-object-type": "off",
        "typescript/no-explicit-any": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "import/no-cycle": "error",
        "import/no-unassigned-import": [
            "warn",
            {
                "allow": ["**/*.css"]
            }
        ],
        "react/exhaustive-deps": "error",
        "react/rules-of-hooks": "error",
        "react/react-in-jsx-scope": "off",
        "react/only-export-components": [
            "error",
            {
                "allowConstantExport": true,
                "allowCompoundComponents": true
            }
        ],
        "unicorn/catch-error-name": [
            "error",
            {
                "name": "err"
            }
        ],
        "unicorn/filename-case": [
            "error",
            {
                "case": "camelCase"
            }
        ],
        "unicorn/no-array-sort": "off"
    },
    "overrides": [
        {
            "files": ["src/**/*.{ts,tsx}"],
            "rules": {
                "no-restricted-globals": [
                    "error",
                    {
                        "globals": [
                            {
                                "name": "process",
                                "message": "Node globals are not available in browser extension code."
                            },
                            {
                                "name": "Buffer",
                                "message": "Node globals are not available in browser extension code."
                            },
                            {
                                "name": "__dirname",
                                "message": "Node globals are not available in browser extension code."
                            },
                            {
                                "name": "__filename",
                                "message": "Node globals are not available in browser extension code."
                            },
                            {
                                "name": "global",
                                "message": "Use globalThis in browser extension code."
                            }
                        ],
                        "checkGlobalObject": true
                    }
                ],
                "no-restricted-properties": [
                    "error",
                    {
                        "object": "chrome",
                        "property": "storage",
                        "message": "Direct chrome.storage access is forbidden; use @wxt-dev/storage inside dedicated storage-owning modules."
                    },
                    {
                        "object": "browser",
                        "property": "storage",
                        "message": "Direct browser.storage access is forbidden; use @wxt-dev/storage inside dedicated storage-owning modules."
                    },
                    {
                        "object": "runtime",
                        "property": "sendMessage",
                        "message": "Direct runtime.sendMessage calls are forbidden; use typed context-scoped helpers from @/messaging."
                    },
                    {
                        "object": "runtime",
                        "property": "onMessage",
                        "message": "Direct runtime.onMessage access is forbidden; use typed context-scoped helpers from @/messaging."
                    },
                    {
                        "object": "runtime",
                        "property": "connect",
                        "message": "Direct runtime.connect calls are forbidden; use typed context-scoped helpers from @/messaging."
                    },
                    {
                        "object": "runtime",
                        "property": "onConnect",
                        "message": "Direct runtime.onConnect access is forbidden; use typed context-scoped helpers from @/messaging."
                    },
                    {
                        "object": "tabs",
                        "property": "sendMessage",
                        "message": "Direct tabs.sendMessage calls are forbidden; use sendTabMessage from @/messaging."
                    },
                    {
                        "object": "tabs",
                        "property": "connect",
                        "message": "Direct tabs.connect calls are forbidden; use typed context-scoped helpers from @/messaging."
                    }
                ],
                "no-restricted-syntax": [
                    "error",
                    {
                        "selector": "MemberExpression[object.property.name=/^(chrome|browser)$/][property.name='storage']",
                        "message": "Direct chrome.storage / browser.storage access is forbidden; use @wxt-dev/storage inside dedicated storage-owning modules."
                    },
                    {
                        "selector": "MemberExpression[object.property.name='runtime'][property.name=/^(sendMessage|onMessage|connect|onConnect)$/]",
                        "message": "Direct runtime messaging APIs are forbidden; use typed context-scoped helpers from @/messaging."
                    },
                    {
                        "selector": "MemberExpression[object.property.name='tabs'][property.name=/^(sendMessage|connect)$/]",
                        "message": "Direct tabs messaging APIs are forbidden; use sendTabMessage from @/messaging."
                    }
                ],
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "regex": "^(?:node:|bun(?::|$)|(?:assert|async_hooks|buffer|child_process|cluster|console|constants|crypto|dgram|diagnostics_channel|dns|domain|events|fs|http|http2|https|inspector|module|net|os|path|perf_hooks|process|punycode|querystring|readline|repl|stream|string_decoder|sys|timers|tls|trace_events|tty|url|util|v8|vm|wasi|worker_threads|zlib)(?:/|$))",
                                "message": "Node and Bun built-in modules cannot be imported in browser extension code."
                            },
                            {
                                "regex": "^@webext-core/messaging(?:/|$)",
                                "message": "Do not import @webext-core/messaging directly; use the typed context-scoped helpers from @/messaging."
                            },
                            {
                                "regex": "^@wxt-dev/storage(?:/|$)",
                                "message": "Only dedicated storage-owning modules may import @wxt-dev/storage."
                            }
                        ]
                    }
                ]
            }

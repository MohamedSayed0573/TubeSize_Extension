{
    "extends": "./.wxt/tsconfig.json",
    "compilerOptions": {
        "useDefineForClassFields": true,
        "lib": ["es2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "chrome", "bun", "node"],
        "skipLibCheck": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "noUncheckedIndexedAccess": true,
        "paths": {
            "@": ["./src"],
            "@/*": ["./src/*"],
            "@components": ["./src/components"],
            "@components/*": ["./src/components/*"],
            "@styles/*": ["./src/styles/*"],
            "@pages/*": ["./src/pages/*"],
            "@lib/*": ["./src/lib/*"],
            "@tests/*": ["./src/tests/*"],
            "@assets/*": ["./src/assets/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@app-types/*": ["./src/types/*"],
            "@layouts/*": ["./src/layouts/*"]
        }
    },
    // `.wxt/wxt.d.ts` pulls in WXT's generated types (import.meta.env` globals like `BROWSER`/`FIREFOX`).
    "include": ["./src", "wxt.config.ts", "./.wxt/wxt.d.ts"]
}
